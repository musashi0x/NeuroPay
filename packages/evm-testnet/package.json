{
  "name": "@neuro-pay/evm-testnet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "chain": "tsx scripts/chain.ts",
    "build:token": "tsx scripts/build-token.ts",
    "deploy:token": "tsx --env-file-if-exists=../../apps/api/.env scripts/deploy-test-token.ts",
    "approve:permit2": "tsx --env-file-if-exists=../../apps/api/.env scripts/approve-permit2.ts"
  },
  "dependencies": {
    "@neuro-pay/types": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@neuro-pay/eslint-config": "workspace:*",
    "@neuro-pay/tsconfig": "workspace:*",
    "@types/node": "^22.18.12",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
