    "test": "vitest run",
    "provision": "tsx scripts/provision.ts"
  },
  "dependencies": {
    "@altananetwork/sdk": "catalog:",
    "@neuro-pay/metering": "workspace:*",
    "@neuro-pay/types": "workspace:*",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@neuro-pay/eslint-config": "workspace:*",
    "@neuro-pay/tsconfig": "workspace:*",
    "@types/node": "^22.18.12",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
