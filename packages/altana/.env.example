# Chain, token, and recipient — read by loadAppConfig() in @neuro-pay/altana.
# Defaults below target BNB Smart Chain testnet (chain 97). Secrets are blank
# on purpose: they load from the environment or a keychain, never from the repo.

# EVM chain the session and settlements live on. Default: 97 (BNB testnet).
CHAIN_ID=97

# JSON-RPC endpoint for contract reads and settlement submission. Required.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# ERC-20 that payments are denominated in. Required.
# Default matches apps/api: NeuroPayTestUSD (npUSD) on chain 97.
TOKEN_ADDRESS=0xba12ccc0e59f3d71114d147b11bc4581b723559f

# ERC-20 symbol of TOKEN_ADDRESS. Required, asserted against symbol() at
# startup together with decimals() and contract code.
TOKEN_SYMBOL=npUSD

# Decimals of TOKEN_ADDRESS. Required, and never a literal in code: 18 on BNB,
# 6 on some Ethereum stables. A cap written for the wrong one is ~10^12 off
# and every payment reverts against a limit that reads as generous. Asserted
# against the token contract's decimals() at startup.
TOKEN_DECIMALS=18

# Recipient of settled payments, bound into every Permit2 witness so a
# compromised settler key cannot redirect earnings. Required.
PAY_TO=

# EOA that submits permitWitnessTransferFrom and pays its gas. Required.
# Needs testnet BNB; a drained settler stops settlement while verification
# keeps passing.
SETTLER_PRIVATE_KEY=

# Wallet admin key. Needed only for wallet creation, grantSession, rail
# provisioning, and revokeSession — leave unset in a running agent process.
# A leaked session key is bounded by the cap and expiry; a leaked admin key is
# total loss of the wallet.
ADMIN_PRIVATE_KEY=

# Session-key private key. Optional at grant time; required for a later
# buyer process (`pnpm --filter @neuro-pay/api demo:real`) to sign.
# When set, provision registers this key on chain instead of generating
# an ephemeral one. Never persisted by SessionStore.
# SESSION_PRIVATE_KEY=

# Session key lifetime in seconds, used to derive the absolute on-chain expiry.
# Default: 86400 (one day).
SESSION_LIFETIME_SECONDS=86400

# Per-period spend cap in whole tokens (may be fractional, e.g. "0.5").
# Required. The grant path multiplies this by 10^TOKEN_DECIMALS to derive
# the on-chain smallest-unit limit, so the cap's units are always whole
# tokens from the operator's perspective.
SESSION_SPEND_CAP=10

# Period the on-chain spend cap resets over, in seconds. The local budget
# window aligns to it. Default: 86400.
SESSION_SPEND_PERIOD_SECONDS=86400
