{
  "extends": "@neuro-pay/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src"]
}
