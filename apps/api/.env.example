PORT=4000
CORS_ORIGIN=http://localhost:3000

# Logging
# Log level: fatal, error, warn, info, debug, trace, silent. Default: info in prod, debug in dev.
LOG_LEVEL=info
# Log format: json (production) or pretty (development). Default: auto-detected from NODE_ENV.
# LOG_FORMAT=json

# ---------------------------------------------------------------------------
# x402 micropayment streaming
#
# The API composes the buyer (@neuro-pay/altana) and the seller, so it needs
# the full set. loadAppConfig() throws a named MissingConfigError or
# InvalidConfigError at startup for anything required that is unset or
# malformed. Values below target BNB Smart Chain testnet (chain 97).
# ---------------------------------------------------------------------------

# --- Chain and token ---

# EVM chain the session and settlements live on. Default: 97 (BNB testnet).
CHAIN_ID=97

# JSON-RPC endpoint for contract reads and settlement submission. Required.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Network the forked-EVM suites fork (`pnpm test:chain`). Falls back to
# RPC_URL when unset. Read straight out of this file by the chain vitest
# configs — Vitest does not load .env into process.env on its own, and
# without it every chain suite skips while the run still reports success.
#
# Point it at an *archive* endpoint if you need a pinned fork block: the
# public endpoints prune state past roughly a thousand blocks, so pinning
# anything older fails with `missing trie node`.
FORK_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# ERC-20 that payments are denominated in. Required.
#
# Default is `NeuroPayTestUSD` (npUSD), deployed by this project on chain
# 97 — source in `packages/evm-testnet/contracts/`. It exists because
# funding a test wallet any other way is a manual errand: the BSC testnet
# USDT everyone cites (0x337610d2…) is owner-gated by a third party and
# cannot be minted here, and the official faucet gates claims behind
# mainnet BNB and a once-per-day limit.
#
# npUSD has an open mint, so any wallet can fund itself:
#   pnpm --filter @neuro-pay/evm-testnet deploy:token -- --dry-run
# and the contract refuses to deploy on a production chain id, so a free
# mint can never land somewhere it would be mistaken for value.
#
# Point this at a different ERC-20 whenever you need one; nothing below
# assumes npUSD beyond its 18 decimals.
TOKEN_ADDRESS=0xba12ccc0e59f3d71114d147b11bc4581b723559f

# Decimals of TOKEN_ADDRESS. Required, and never a literal in code: 18 on BNB,
# 6 for Ethereum USDC. Asserted against the token contract's decimals() at
# startup, because a cap written for the wrong one is ~10^12 off and every
# payment reverts against a limit that reads as generous.
TOKEN_DECIMALS=18

# Recipient of settled payments, bound into every Permit2 witness so a
# compromised settler key cannot redirect earnings. Required.
PAY_TO=

# --- Secrets (leave blank in the repo; load from the environment) ---

# EOA that submits permitWitnessTransferFrom and pays its gas. Required.
# Needs testnet BNB; a drained settler stops settlement while verification
# keeps passing, which the ledger reports as a distinct alarm.
SETTLER_PRIVATE_KEY=

# Wallet admin key. Needed only for wallet creation, grantSession, rail
# provisioning, and revokeSession — leave unset in the running API process.
# A leaked session key is bounded by the cap and expiry; a leaked admin key is
# total loss of the wallet.
ADMIN_PRIVATE_KEY=

# Session-key private key. Required by `pnpm demo:real` so the buyer
# process can reattach a signer the store never persists. Use the same
# value that was passed to `pnpm --filter @neuro-pay/altana provision`.
# SESSION_PRIVATE_KEY=

# --- Session policy (committed on chain at grant time) ---

# Session key lifetime in seconds, used to derive the absolute on-chain expiry.
# Default: 86400 (one day).
SESSION_LIFETIME_SECONDS=86400

# On-chain spend limit per period, in whole tokens (not smallest units).
# Required. Converted to smallest units at config time using TOKEN_DECIMALS.
# "10" on an 18-decimal token becomes 10e18; writing 10e18 here would be
# 10e36 and every payment would look like it fit a generous cap.
SESSION_SPEND_CAP=10

# Period the on-chain spend cap resets over, in seconds. The local budget
# window aligns to it. Default: 86400.
SESSION_SPEND_PERIOD_SECONDS=86400

# --- Settlement policy (chain-free; consumed by @neuro-pay/metering) ---

# Fraction of the on-chain cap held back as local headroom, in [0, 1).
# The local budget trips before the on-chain cap so exhaustion is a clean
# refusal to sign rather than a reverted settlement after delivery.
# Default: 0.2, putting the local budget at 80% of the cap.
BUDGET_MARGIN=0.2

# Accrued amount that triggers a payment demand, in smallest token units
# (digits only). Required. Default below is 0.05 tokens at 18 decimals.
SETTLEMENT_THRESHOLD=50000000000000000

# Seconds since the last payment that trigger a demand regardless of accrual.
# Bounds seller credit exposure on a slow or idle stream. Default: 60.
TICK_INTERVAL_SECONDS=60

# Concurrent settlements the seller will carry. Delivery stops at
# SETTLEMENT_THRESHOLD x this value, which is the seller's maximum
# unrecoverable loss if the buyer walks away. Default: 3.
MAX_IN_FLIGHT_SETTLEMENTS=3

# --- Seller price sheet (what the API charges per segment) ---
#
# All three are in smallest token units (digits only), like
# SETTLEMENT_THRESHOLD. Unset means zero, and a fully zero sheet delivers
# every segment free: the accrual never reaches SETTLEMENT_THRESHOLD, so
# no 402 is ever generated and the payment path is unreachable.
#
# Values below are dev-scale against SETTLEMENT_THRESHOLD=5e16: a segment
# delivers up to 1000 units, so one segment accrues 1e16 and payment is
# demanded every few segments.
PRICE_PER_CALL=0
PRICE_PER_SECOND=0
PRICE_PER_UNIT=10000000000000
# Names what PRICE_PER_UNIT counts, e.g. "token" or "frame".
PRICE_UNIT_NAME=unit

# --- Operator console security ---
#
# Bearer token guarding every console route: session policy, payment
# history, and the revoke kill switch. Unset means the console is
# UNAUTHENTICATED, which is fine on a local dev box and never fine in a
# deployment — anyone who can reach the port can revoke the session.
# At least 32 characters; the process refuses to start with a shorter one.
#
#   openssl rand -hex 32
#
# The web console reads the same variable from its own environment (see
# apps/web/.env.local.example) and holds it server-side. It must never be
# NEXT_PUBLIC_-prefixed: that would inline the kill switch into the
# browser bundle.
CONSOLE_API_TOKEN=

# Most streams that may be open at once, across all callers. The idle
# sweep reclaims abandoned streams, but a caller that opens faster than
# the sweep collects outruns it; this is the standing ceiling. Unset
# means unbounded, which is only appropriate locally.
MAX_CONCURRENT_STREAMS=100

# Local persistence for the session store and the payment ledger.
# Defaults are under .data/, which is gitignored.
SESSION_STORE_PATH=.data/session.json
LEDGER_PATH=.data/ledger.sqlite

# --- Observability and alerting ---
#
# The readiness, metrics, and audit endpoints all sit behind
# CONSOLE_API_TOKEN, except GET /ready, which is open and publishes only
# check names and verdicts (no messages, no addresses, no host names) so
# a load balancer can reach it.
#
#   GET /ready       — liveness-adjacent readiness, unauthenticated
#   GET /v1/health   — probe detail and firing alerts, operator token
#   GET /metrics     — Prometheus exposition, operator token
#   GET /v1/metrics  — the same numbers as JSON, operator token
#   GET /v1/audit    — administrative audit trail, operator token
#
# Every metric is recomputed from the ledger on read rather than kept as
# an in-process counter, so the numbers survive a restart and two
# processes reading the same file agree.

# Unrecovered failed settlements that raise a warning, then a critical.
# The warning default is 1 rather than a rounder number: one failed
# settlement is already a segment that was delivered and will not be
# paid for. Defaults: 1 and 5.
# ALERT_FAILED_SETTLEMENTS_WARN=1
# ALERT_FAILED_SETTLEMENTS_CRITICAL=5

# Native-token balance below which the settler is reported as low, in wei
# (digits only). Below a tenth of this it is reported as drained and the
# readiness probe goes down. Default: 10000000000000000 (0.01), roughly
# ten settlements of headroom on BNB testnet.
# SETTLER_MIN_BALANCE_WEI=10000000000000000

# Remaining session lifetime, in seconds, below which expiry is warned
# about. Streams opened inside this window may outlive the session and be
# refused. Default: 3600.
# ALERT_SESSION_EXPIRY_WARN_SECONDS=3600
