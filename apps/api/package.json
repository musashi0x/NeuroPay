{
  "name": "@neuro-pay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx --env-file-if-exists=.env scripts/demo-stream.ts",
    "seed:session": "tsx --env-file-if-exists=.env scripts/seed-session.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@neuro-pay/altana": "workspace:*",
    "@neuro-pay/ledger": "workspace:*",
    "@neuro-pay/logger": "workspace:*",
    "@neuro-pay/metering": "workspace:*",
    "@neuro-pay/types": "workspace:*",
    "hono": "^4.13.2",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@neuro-pay/eslint-config": "workspace:*",
    "@neuro-pay/tsconfig": "workspace:*",
    "@types/node": "^22.18.12",
    "eslint": "catalog:",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
