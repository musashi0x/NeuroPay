NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Operator console ---
#
# The console's API routes require a bearer token. This value must match
# the API's CONSOLE_API_TOKEN. It is read only by the server-side proxy
# at src/app/api/console/[...path]/route.ts and is deliberately NOT
# NEXT_PUBLIC_-prefixed: Next inlines those into client JavaScript, and a
# token in the bundle is a kill switch published to every visitor.
CONSOLE_API_TOKEN=

# Where the proxy forwards console requests. Server-side only; the
# browser talks to /api/console instead. Defaults to http://localhost:4000.
API_URL=http://localhost:4000
