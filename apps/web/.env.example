# apps/web — landing + operator console.
#
# The web app reads the API URL from here so the console can fetch
# /v1/sessions, /v1/streams, and the SSE feed. The console token is
# the same authorization header the API expects.

# Base URL the console fetches from. Defaults to the dev server started
# by pnpm dev.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Bearer token the console sends to the API. The API reads the same
# value from CONSOLE_TOKEN. Either copy it from apps/api example file
# or set both to the same value.
NEXT_PUBLIC_CONSOLE_TOKEN=

# URL of the client showcase (apps/showcase). The landing page exposes
# a "Try as agent" control that opens this URL. A missing or
# unreachable showcase must not break the landing — the link is just
# an anchor and the showcase renders its own empty states.
NEXT_PUBLIC_SHOWCASE_URL=http://localhost:3001
