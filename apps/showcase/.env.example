# apps/showcase — visitor-facing demo ("try as the agent").
#
# The showcase is a BFF: the BROWSER never sees these values. Only the
# Next.js server-process reads them. Do NOT prefix any of these with
# NEXT_PUBLIC_ — that would land them in the client bundle.

# Seller URL — the @neuro-pay/api process the showcase pays through.
# Local default: the dev server started by pnpm dev.
SELLER_URL=http://localhost:4000

# Path to the persisted session written by pnpm --filter @neuro-pay/altana provision.
# The provision CLI writes to apps/api/.data/session.json by default; the
# showcase mirrors that path so the two share a single grant. Use an
# absolute path if you ran provision from a different working directory.
SESSION_STORE_PATH=../../apps/api/.data/session.json

# The session key that signed the grant. Required: the showcase run loop
# refuses to start without it. The store never persists this — the showcase
# reads it from the parent process env at request time.
SESSION_PRIVATE_KEY=

# Margin applied to the on-chain spend cap to derive the local pre-sign
# refusal line. 0.2 (20%) matches the demo defaults. Use a fraction in [0, 1).
BUDGET_MARGIN=0.2

# Delay between segment pulls, in milliseconds. Keeps the seller
# exposure-limit comfortable on a stock 8-segment run.
SEGMENT_DELAY_MS=500

# Default segment count when the Run button is clicked without a count.
# Capped at 20 by the BFF.
DEFAULT_SEGMENTS=8

# Token symbol for amount display. The seller does not publish its symbol
# over the wire; the showcase labels amounts with this value. Defaults to
# the chain config shipped by apps/api/.
SHOWCASE_TOKEN_SYMBOL=npUSD
