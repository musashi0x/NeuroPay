{
  "name": "neuro-pay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "turbo lint typecheck test build && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:chain": "turbo test:chain",
    "chain:up": "docker compose -f packages/evm-testnet/compose.yaml --env-file apps/api/.env up -d --wait",
    "chain:down": "docker compose -f packages/evm-testnet/compose.yaml --env-file apps/api/.env down",
    "chain:logs": "docker compose -f packages/evm-testnet/compose.yaml --env-file apps/api/.env logs -f anvil"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
