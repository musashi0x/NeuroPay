{
  "name": "neuro-pay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "turbo lint typecheck test build && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "panels": "pnpm --filter @neuro-pay/web panels"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
